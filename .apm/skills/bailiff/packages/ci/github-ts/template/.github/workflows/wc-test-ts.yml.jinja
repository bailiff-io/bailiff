{%- set run = "bun run " if ts_pkg_manager == "bun" else ("pnpm run " if ts_pkg_manager == "pnpm" else "npm run ") -%}
name: Test TypeScript

on:
  workflow_call:
    inputs:
      node-version:
        description: Override the Node version.
        required: false
        type: string
        default: "{{ node_version }}"
      working-directory:
        description: Directory to run in. Set this per package in a monorepo.
        required: false
        type: string
        default: "."

permissions:
  contents: read

{%- set runners = ci_os_matrix or ['ubuntu-latest'] %}
jobs:
  test:
    name: Test
{%- if runners|length > 1 or ci_version_matrix %}
    strategy:
      fail-fast: false
      matrix:
{%- if runners|length > 1 %}
        os: [{% for os in runners %}{{ os }}{{ ", " if not loop.last }}{% endfor %}]
{%- endif %}
{%- if ci_version_matrix %}
        node-version: [{% for v in ci_version_matrix %}"{{ v }}"{{ ", " if not loop.last }}{% endfor %}]
{%- endif %}
    runs-on: {{ '${{ matrix.os }}' if runners|length > 1 else runners[0] }}
    timeout-minutes: {{ ci_job_timeout_minutes | default(15) }}
{%- else %}
    runs-on: {{ runners[0] }}
    timeout-minutes: {{ ci_job_timeout_minutes | default(15) }}
{%- endif %}
    defaults:
      run:
        working-directory: ${{ '{{' }} inputs.working-directory }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The default leaves GITHUB_TOKEN in .git/config for later steps to
          # read. zizmor reports the default as a finding.
          persist-credentials: false

      - uses: ./.github/actions/setup-ts
        with:
{%- if ci_version_matrix %}
          node-version: ${{ '{{' }} matrix.node-version }}
{%- else %}
          node-version: ${{ '{{' }} inputs.node-version }}
{%- endif %}

      - name: Test
        run: {{ run }}{{ ts_test_command }}
