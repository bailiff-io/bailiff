{%- set run = "bun run " if ts_pkg_manager == "bun" else ("pnpm run " if ts_pkg_manager == "pnpm" else "npm run ") -%}
{%- set exec = "bunx " if ts_pkg_manager == "bun" else ("pnpm dlx " if ts_pkg_manager == "pnpm" else "npx ") -%}
name: Lint TypeScript

on:
  workflow_call:
    inputs:
      working-directory:
        description: Directory to run in. Set this per package in a monorepo.
        required: false
        type: string
        default: "."

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    timeout-minutes: {{ ci_job_timeout_minutes | default(15) }}
    defaults:
      run:
        working-directory: ${{ '{{' }} inputs.working-directory }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The default leaves GITHUB_TOKEN in .git/config for later steps to
          # read. zizmor reports the default as a finding.
          persist-credentials: false

      - uses: ./.github/actions/setup-ts
{%- if ts_linter == "biome" %}

      - name: Biome check
        run: {{ exec }}biome check --no-errors-on-unmatched .
{%- elif ts_linter == "oxlint" %}

      - name: oxlint
        run: {{ exec }}oxlint

      - name: oxfmt
        run: {{ exec }}oxfmt --check
{%- endif %}
{%- if ts_linter != "none" %}

      # Neither linter formats markdown or YAML.
      - name: Prettier
        run: {{ exec }}prettier --check .
{%- endif %}
{%- if ts_typecheck %}

      - name: Type check
        run: {{ exec }}tsc --noEmit
{%- endif %}
