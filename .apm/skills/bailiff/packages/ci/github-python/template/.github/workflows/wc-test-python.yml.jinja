name: Test Python

on:
  workflow_call:
    inputs:
      python-version:
        description: Override the Python version.
        required: false
        type: string
        default: "{{ python_version }}"
      working-directory:
        description: Directory to run in. Set this per package in a monorepo.
        required: false
        type: string
        default: "."

permissions:
  contents: read

{%- set runners = ci_os_matrix or ['ubuntu-latest'] %}
jobs:
  test:
    name: Test
{%- if runners|length > 1 or ci_version_matrix %}
    strategy:
      fail-fast: false
      matrix:
{%- if runners|length > 1 %}
        os: [{% for os in runners %}{{ os }}{{ ", " if not loop.last }}{% endfor %}]
{%- endif %}
{%- if ci_version_matrix %}
        python-version: [{% for v in ci_version_matrix %}"{{ v }}"{{ ", " if not loop.last }}{% endfor %}]
{%- endif %}
    runs-on: {{ '${{ matrix.os }}' if runners|length > 1 else runners[0] }}
{%- else %}
    runs-on: {{ runners[0] }}
{%- endif %}
    defaults:
      run:
        working-directory: ${{ '{{' }} inputs.working-directory }}
    steps:
      - uses: actions/checkout@v7

      - uses: ./.github/actions/setup-python
        with:
{%- if ci_version_matrix %}
          python-version: ${{ '{{' }} matrix.python-version }}
{%- else %}
          python-version: ${{ '{{' }} inputs.python-version }}
{%- endif %}

      - name: Test
{%- if python_pkg_manager == "uv" %}
        run: uv run {{ python_test_command }}
{%- elif python_pkg_manager == "pdm" %}
        run: pdm run {{ python_test_command }}
{%- else %}
        run: {{ python_test_command }}
{%- endif %}
