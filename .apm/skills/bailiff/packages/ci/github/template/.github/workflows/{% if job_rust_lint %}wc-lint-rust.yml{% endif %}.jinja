name: Lint Rust

on:
  workflow_call:
    inputs:
      working-directory:
        description: Directory to run in. Set this per crate in a workspace.
        required: false
        type: string
        default: "."

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(15) }}
    defaults:
      run:
        working-directory: ${{ '{{' }} inputs.working-directory }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The default leaves GITHUB_TOKEN in .git/config for later steps to
          # read. zizmor reports the default as a finding.
          persist-credentials: false

      - uses: ./.github/actions/setup-rust

      - name: rustfmt
        run: cargo fmt --all -- --check

      - name: clippy
        run: cargo clippy --all-targets{{ ' --all-features' if rust_all_features }} -- -D warnings
