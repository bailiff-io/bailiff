name: Secret scan

# The commit hook scans the staged index. This scans the full history, which is
# what catches a secret pushed with --no-verify or committed before the hook
# existed. trufflehog verifies a candidate against the issuing API, so it reports
# live credentials the regex scanners rate too low-entropy to flag.

on:
  workflow_call:

permissions:
  contents: read

jobs:
  secrets:
    name: Secret scan
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(15) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The full history: a secret is usually in an older commit, and the
          # default shallow clone would not fetch it.
          fetch-depth: 0
          persist-credentials: false

      - name: Verified credentials
        uses: trufflesecurity/trufflehog@6f3c981e7b77f235fd2702dd74af25fc4b72bf11 # v3.96.0
        with:
          extra_args: --results=verified --fail
