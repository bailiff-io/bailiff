name: Lint Go

on:
  workflow_call:
    inputs:
      working-directory:
        description: Directory to run in. Set this per package in a monorepo.
        required: false
        type: string
        default: "."

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(15) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The default leaves GITHUB_TOKEN in .git/config for later steps to
          # read. zizmor reports the default as a finding.
          persist-credentials: false

      - uses: ./.github/actions/setup-go

      - name: golangci-lint
        uses: golangci/golangci-lint-action@ba0d7d2ec06a0ea1cb5fa41b2e4a3ab91d21278a # v9.3.0
        with:
          version: v2.12.2
          working-directory: ${{ '{{' }} inputs.working-directory }}

      - name: gofmt
        working-directory: ${{ '{{' }} inputs.working-directory }}
        run: |
          unformatted=$(gofmt -l .)
          if [ -n "$unformatted" ]; then
            echo "::error::gofmt needs to run on:"
            echo "$unformatted"
            exit 1
          fi
