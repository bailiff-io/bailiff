name: Quality

# The second layer. hooks/baseline runs what is fast enough per commit against
# staged files; these are the checks too slow for that, plus the repo-wide forms
# of checks the hook runs against the index only.
#
# Measured on a 212-file repo: cspell 1.7s, pinact 1.4s (network), markdownlint
# 1.2s, yamllint 1.1s, lizard 3.1s whole-repo. All of them run here rather than on
# commit.

on:
  workflow_call:

permissions:
  contents: read

jobs:
  quality:
    name: Quality
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(15) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false

      - name: Install tools
        uses: jdx/mise-action@9e7f7633ff6f6d6048a9418a68d48f288f50eb14 # v4.2.3
        with:
          # The repo pins these in .mise/conf.d/, so CI runs the versions the
          # hooks run rather than whatever is newest.
          cache: true
{%- if quality_pinact %}

      # Enforces the SHA-pinning policy every rendered workflow follows. This is
      # a hook only in spirit: it resolves each tag through the GitHub API, which
      # makes it too slow and too network-dependent for a commit.
      - name: Actions pinned to SHAs
        run: pinact run --check
{%- endif %}
{%- if quality_yaml %}

      # Without a project .yamllint the defaults flag 80-column lines and a
      # missing document start, neither of which is a project rule, and GitHub
      # workflows routinely exceed 80 columns.
      - name: YAML lint
        run: |
          if [ -f .yamllint ] || [ -f .yamllint.yaml ]; then
            yamllint -f github .
          else
            yamllint -f github \
              -d "{extends: relaxed, rules: {line-length: disable, document-start: disable}}" .
          fi
{%- endif %}
{%- if quality_markdown %}

      - name: Markdown lint
        run: npx --yes markdownlint-cli2 "**/*.md" "#node_modules"
{%- endif %}
{%- if quality_spelling %}

      - name: Spell check
        run: npx --yes cspell lint --no-progress --no-summary .
{%- endif %}
{%- if quality_links %}

      # The commit hook runs lychee with --offline, which resolves relative links
      # and skips network URLs. This is the run that actually reaches them.
      - name: Link check
        run: lychee --no-progress --accept 200,204,206,429 '**/*.md'
{%- endif %}
{%- if quality_complexity %}

      # Whole-repo rather than staged: the hook bounds a commit, this reports the
      # codebase.
      - name: Complexity
        run: uvx lizard -C {{ quality_ccn }} -L {{ quality_length }} -a {{ quality_args }} -w .
{%- endif %}
{%- if quality_duplication %}

      # Cross-file duplication cannot be seen from a staged set, so it has no
      # commit-hook form at all.
      - name: Duplication
        run: npx --yes jscpd --reporters consoleFull --min-tokens {{ quality_dup_tokens }} .
{%- endif %}
