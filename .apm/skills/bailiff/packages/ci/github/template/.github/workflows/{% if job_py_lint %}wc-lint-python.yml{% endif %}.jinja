name: Lint Python

on:
  workflow_call:
    inputs:
      working-directory:
        description: Directory to run in. Set this per package in a monorepo.
        required: false
        type: string
        default: "."

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(15) }}
    defaults:
      run:
        working-directory: ${{ '{{' }} inputs.working-directory }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The default leaves GITHUB_TOKEN in .git/config for later steps to
          # read. zizmor reports the default as a finding.
          persist-credentials: false

{% set run = "uv run " if python_pkg_manager == "uv" else ("pdm run " if python_pkg_manager == "pdm" else "") %}
      - uses: ./.github/actions/setup-python

      - name: Ruff check
        run: {{ run }}ruff check .

      - name: Ruff format
        run: {{ run }}ruff format --check .
{%- if python_type_checker != "none" %}

      - name: Type check
        run: {{ run }}{{ python_type_checker }} .
{%- endif %}
