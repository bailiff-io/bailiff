name: Test Rust

on:
  workflow_call:
    inputs:
      toolchain:
        description: Override the Rust toolchain.
        required: false
        type: string
        default: "{{ rust_toolchain }}"
      working-directory:
        description: Directory to run in. Set this per crate in a workspace.
        required: false
        type: string
        default: "."

permissions:
  contents: read

{%- set runners = ci_os_matrix or ['ubuntu-latest'] %}
jobs:
  test:
    name: Test
{%- if runners|length > 1 or rust_version_matrix %}
    strategy:
      fail-fast: false
      matrix:
{%- if runners|length > 1 %}
        os: [{% for os in runners %}{{ os }}{{ ", " if not loop.last }}{% endfor %}]
{%- endif %}
{%- if rust_version_matrix %}
        toolchain: [{% for v in rust_version_matrix %}"{{ v }}"{{ ", " if not loop.last }}{% endfor %}]
{%- endif %}
    runs-on: {{ '${{ matrix.os }}' if runners|length > 1 else runners[0] }}
    timeout-minutes: {{ job_timeout_minutes | default(15) }}
{%- else %}
    runs-on: {{ runners[0] }}
    timeout-minutes: {{ job_timeout_minutes | default(15) }}
{%- endif %}
    defaults:
      run:
        working-directory: ${{ '{{' }} inputs.working-directory }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The default leaves GITHUB_TOKEN in .git/config for later steps to
          # read. zizmor reports the default as a finding.
          persist-credentials: false

      - uses: ./.github/actions/setup-rust
        with:
{%- if rust_version_matrix %}
          toolchain: ${{ '{{' }} matrix.toolchain }}
{%- else %}
          toolchain: ${{ '{{' }} inputs.toolchain }}
{%- endif %}

      - name: Test
        run: cargo {{ rust_test_command }}{{ ' --all-features' if rust_all_features }}
