name: Set up TypeScript
description: Installs Node {{ node_version }} and the project dependencies with {{ ts_pkg_manager }}.

inputs:
  node-version:
    description: Node version to install.
    required: false
    default: "{{ node_version }}"

runs:
  using: composite
  steps:
{%- if ts_pkg_manager == "bun" %}
    - name: Set up Bun
      uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2.2.0
      with:
        bun-version: latest

    - name: Install dependencies
      shell: bash
      run: bun install --frozen-lockfile
{%- elif ts_pkg_manager == "pnpm" %}
    - name: Set up pnpm
      uses: pnpm/action-setup@0ebf47130e4866e96fce0953f49152a61190b271 # v6.0.9
      with:
        run_install: false

    - name: Set up Node
      uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
      with:
        node-version: ${{ '{{' }} inputs.node-version }}
{%- if ci_cache %}
        cache: pnpm
{%- endif %}

    - name: Install dependencies
      shell: bash
      run: pnpm install --frozen-lockfile
{%- else %}
    - name: Set up Node
      uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
      with:
        node-version: ${{ '{{' }} inputs.node-version }}
{%- if ci_cache %}
        cache: npm
{%- endif %}

    - name: Install dependencies
      shell: bash
      run: npm ci
{%- endif %}
