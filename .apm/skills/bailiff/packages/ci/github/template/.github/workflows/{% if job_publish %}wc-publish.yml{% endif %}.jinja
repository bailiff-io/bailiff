name: Publish

# The release tools tag a version and open a PR. Nothing shipped the artifact
# until this workflow existed.
#
# Every ecosystem here supports OIDC trusted publishing, so no long-lived token is
# stored in the repository. That needs a one-time setup step per ecosystem, which
# package.md lists.

on:
  workflow_call:
    inputs:
      working-directory:
        description: Directory to publish from. Set this per package in a monorepo.
        required: false
        type: string
        default: "."

permissions:
  contents: read

jobs:
{%- if 'python' in ci_languages %}
  pypi:
    name: Publish to PyPI
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(15) }}
    environment: release
    permissions:
      # Trusted publishing exchanges this for a short-lived PyPI token. With it,
      # no API token is stored in the repository at all.
      id-token: write
    defaults:
      run:
        working-directory: ${{ '{{' }} inputs.working-directory }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false

      - uses: ./.github/actions/setup-python

      - name: Build
        run: {% if python_pkg_manager == 'uv' %}uv build{% else %}pdm build{% endif %}
{%- if publish_attest %}

      - name: Attest provenance
        uses: actions/attest-build-provenance@0f67c3f4856b2e3261c31976d6725780e5e4c373 # v4.1.1
        with:
          subject-path: ${{ '{{' }} inputs.working-directory }}/dist/*
{%- endif %}

      - name: Publish
        uses: pypa/gh-action-pypi-publish@2834a314042ef964da07689278dd1e9d773e8afd # v1.14.1
        with:
          packages-dir: ${{ '{{' }} inputs.working-directory }}/dist
{%- endif %}
{%- if 'ts' in ci_languages %}
  npm:
    name: Publish to npm
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(15) }}
    environment: release
    permissions:
      # npm 12 reads this to attach a provenance statement to the published
      # package, which is what --provenance below requires.
      id-token: write
    defaults:
      run:
        working-directory: ${{ '{{' }} inputs.working-directory }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false

      - uses: ./.github/actions/setup-ts

      - name: Publish
        run: npm publish --provenance --access public
        env:
          NODE_AUTH_TOKEN: ${{ '{{' }} secrets.NPM_TOKEN }}
{%- endif %}
{%- if 'rust' in ci_languages %}
  crates:
    name: Publish to crates.io
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(15) }}
    environment: release
    permissions:
      id-token: write
    defaults:
      run:
        working-directory: ${{ '{{' }} inputs.working-directory }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false

      - uses: ./.github/actions/setup-rust

      # Exchanges the OIDC token for a short-lived registry token and exports it
      # as CARGO_REGISTRY_TOKEN, so no crates.io token is stored in the repo.
      - name: Authenticate
        uses: rust-lang/crates-io-auth-action@c6f97d42243bad5fab37ca0427f495c86d5b1a18 # v1.0.5
        id: auth

      - name: Publish
        run: cargo publish
        env:
          CARGO_REGISTRY_TOKEN: ${{ '{{' }} steps.auth.outputs.token }}
{%- endif %}
{%- if 'go' in ci_languages %}
  goreleaser:
    name: Release binaries
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(30) }}
    permissions:
      # goreleaser creates the GitHub release and uploads the binaries.
      contents: write
      id-token: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # goreleaser reads the tag history to build the changelog, so the
          # default shallow clone gives it nothing to work from.
          fetch-depth: 0
          persist-credentials: false

      - uses: ./.github/actions/setup-go

      - name: Release
        uses: goreleaser/goreleaser-action@f06c13b6b1a9625abc9e6e439d9c05a8f2190e94 # v7.2.3
        with:
          args: release --clean
        env:
          GITHUB_TOKEN: ${{ '{{' }} secrets.GITHUB_TOKEN }}
{%- endif %}
