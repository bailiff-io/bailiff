{#-
  .tflint.hcl -- enables the terraform ruleset. Cloud-provider rulesets are
  commented examples; uncomment the one matching the provider. Security scanning
  runs through the trivy hook in .pre-commit.d/terraform.yaml.
-#}
plugin "terraform" {
  enabled = true
  preset  = "recommended"
}

