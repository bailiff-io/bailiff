{#- .hooks.d/go.yaml -- gofmt and golangci-lint in lefthook's schema.
    golangci-lint runs on the whole module rather than on staged files: it is
    package-scoped, and a single-file invocation reports phantom errors for
    symbols defined in the files that were left out. -#}
pre-commit:
  parallel: false
  commands:
    gofmt:
      glob: "*.go"
      run: gofmt -w {staged_files}
      stage_fixed: true
{%- if golangci_hook_rev %}
    golangci-lint:
      glob: "*.go"
      run: golangci-lint run ./...
{%- endif %}
    # `go mod tidy -diff` reports what tidy would change and exits non-zero
    # instead of rewriting the files, so a stale go.mod fails rather than being
    # silently fixed mid-commit.
    go-mod-tidy:
      glob: "*.{go,mod,sum}"
      run: go mod tidy -diff
{%- if go_vulncheck %}

pre-push:
  commands:
    # Queries the vulnerability database, so it belongs on push rather than on
    # every commit.
    govulncheck:
      run: govulncheck ./...
{%- endif %}
