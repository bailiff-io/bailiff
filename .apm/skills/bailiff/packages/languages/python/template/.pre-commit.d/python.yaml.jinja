# .pre-commit.d/python.yaml -- ruff hooks contributed by the python package.
# precommit reads .pre-commit.d/ and folds every fragment into its config.
repos:
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: "{{ ruff_version if ruff_version else 'v0.16.0' }}"
    hooks:
      - id: ruff
        args: [--fix]
      - id: ruff-format
