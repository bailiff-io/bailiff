# ruff.toml -- rendered by the bailiff python package.

target-version = "py{{ python_version | replace('.', '') }}"
line-length = {{ ruff_line_length }}

[lint]
{%- set rules = ["E", "F", "I", "N", "W", "UP", "B", "SIM", "TC"] %}
{%- if ruff_rule_profile == "strict" %}
{%- set rules = rules + ["ANN", "RUF", "PERF", "C4", "PT"] %}
{%- endif %}
{#- S is bandit ported into ruff, so the security lint needs no separate tool. -#}
{%- if ruff_rule_profile == "strict" %}
{%- set rules = rules + ["S"] %}
{%- endif %}
{#- DOC is ruff's pydoclint port: it compares the documented params, returns,
    and raises against the real signature, so it catches a docstring that
    drifted after a refactor rather than one that is merely missing. -#}
{%- if python_docstring_accuracy %}
{%- set rules = rules + ["DOC"] %}
{%- endif %}
{%- if python_docstring_check == "enforce" %}
{%- set rules = rules + ["D"] %}
{%- endif %}
select = [{% for r in rules %}"{{ r }}"{{ ", " if not loop.last }}{% endfor %}]
{%- if python_docstring_accuracy %}

# DOC rules are preview-gated. Without this, ruff prints "Selection `DOC` has no
# effect because preview is not enabled" and checks nothing.
preview = true
{%- endif %}
{%- if python_docstring_check == "warn" %}

# D is deliberately NOT selected here. ruff has no per-rule severity, so a
# selected rule fails `ruff check`, and docstring presence is meant to be
# advisory. The advisory hook passes --select D --exit-zero explicitly, which
# reports the findings without a config entry and without gating the commit.
{%- endif %}
{%- if python_docstring_check != "none" %}

[lint.pydocstyle]
convention = "google"
{%- endif %}
{%- if ruff_rule_profile == "strict" %}

[lint.per-file-ignores]
# Test files assert, and a bare assert is the point.
"tests/**" = ["S101"]
{%- endif %}

[format]
quote-style = "{{ ruff_quote_style }}"
