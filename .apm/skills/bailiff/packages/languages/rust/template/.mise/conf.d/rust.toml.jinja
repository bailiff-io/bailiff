# .mise/conf.d/rust.toml -- tools owned by the rust package.
# mise merges every .mise/conf.d/*.toml at runtime.
[tools]
rust = "{{ rust_channel }}"
{% if test_runner == 'nextest' %}cargo-nextest = "latest"
{% endif %}{% if rust_deny %}"aqua:EmbarkStudios/cargo-deny" = "0.20.2"
{% endif %}{% if rust_unused_deps %}"cargo:cargo-machete" = "0.9.2"
{% endif %}{% if rust_coverage %}"cargo:cargo-llvm-cov" = "0.8.7"
{% endif %}